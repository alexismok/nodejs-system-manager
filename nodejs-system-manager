parse_options() {
    REMAINING_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --verbose|-v)
                LOG_LEVEL=0
                shift
                ;;
            --syslog)
                SYSLOG_ENABLED=true
                shift
                ;;
            --no-timestamp)
                LOG_TIMESTAMP=false
                shift
                ;;
            --no-colors)
                LOG_COLORS=false
                JSON_OUTPUT_CMD="${JSON_OUTPUT_CMD} -M"
                shift
                ;;
            --log-file)
                [[ "$#" -ge 2 ]] || die "--log-file requires an argument"
                ! _startswith "$2" "-" || die "--log-file requires a valid path"
                LOG_FILE="$2"
                shift 2
                ;;
            --nodejs-root)
                [[ "$#" -ge 2 ]] || die "--nodejs-root requires an argument"
                ! _startswith "$2" "-" || die "--nodejs-root requires a valid path"
                NODEJS_ROOT="$2"
                shift 2
                ;;
            --bin-dir)
                [[ "$#" -ge 2 ]] || die "--bin-dir requires an argument"
                ! _startswith "$2" "-" || die "--bin-dir requires a valid path"
                BIN_DIR="$2"
                shift 2
                ;;
            --lock-dir)
                [[ "$#" -ge 2 ]] || die "--lock-dir requires an argument"
                ! _startswith "$2" "-" || die "--lock-dir requires a valid path"
                LOCK_DIR="$2"
                shift 2
                ;;
            --cache-dir)
                [[ "$#" -ge 2 ]] || die "--cache-dir requires an argument"
                ! _startswith "$2" "-" || die "--cache-dir requires a valid path"
                CACHE_DIR="$2"
                shift 2
                ;;
            --skip-index-cache)
                CACHE_INDEX_FILE_SKIPPED=true
                shift
                ;;
            --cache-index-ttl)
                [[ "$#" -ge 2 ]] || die "--cache-index-ttl requires an argument"
                [[ "$2" =~ ^[0-9]+$ && "$2" -ge 0 ]] || die "--cache-index-ttl require a valid duration (Integer >= 0)"
                CACHE_INDEX_TTL="$2"
                shift 2
                ;;
            --ignore-hooks)
                DISABLE_HOOKS=true
                shift
                ;;
            --force|-f)
                FORCE=true
                shift
                ;;
            --help|-h)
                if [[ -n "$ACTION_NAME" ]]; then
                    "help_${ACTION_NAME}"
                else
                    help_global
                fi
                exit 0
                ;;
            --packages-only)
                PACKAGES_ONLY=true
                shift
                ;;
            --quiet|-q)
                QUIET=true
                shift
                ;;
            --json)
                JSON_OUTPUT=true
                shift
                ;;
            --json-compact)
                JSON_OUTPUT=true
                JSON_OUTPUT_CMD="${JSON_OUTPUT_CMD} -c"
                shift
                ;;
            --ignore-unmanaged)
                IGNORE_UNMANAGED=true
                shift
                ;;
            --ignore-managed)
                IGNORE_MANAGED=true
                shift
                ;;
            --version|-V)
                ACTION_NAME="version"
                shift
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                # Args not starting with "-" or "--" are action parameters
                REMAINING_ARGS+=("$1")
                shift
                ;;
        esac
    done
}

bootstrap_config() {
    REMAINING_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --config-dir)
                [[ "$#" -ge 2 ]] || die "--config-dir requires an argument"
                ! _startswith "$2" "-" || die "--config-dir requires a valid path"
                CONFIG_DIR="$2"
                shift 2
                ;;
            *)
                REMAINING_ARGS+=("$1")
                shift
                ;;
        esac
    done
}

CONFIG_VARS=(
    CONFIG_DIR CONFIG_FILE NODEJS_ROOT LOCK_DIR BIN_DIR CACHE_DIR
    PACKAGES_DIR HOOK_DIR
    LOG_LEVEL LOG_COLORS LOG_TIMESTAMP SYSLOG_ENABLED
    CACHE_INDEX_TTL CACHE_INDEX_FILE_SKIPPED DISABLE_HOOKS
    CACHE_INDEX_FILE LOCK_FILE MANAGED_FILE LOG_FILE
)

dump_config() {
    if [[ "$JSON_OUTPUT" == "true" ]]; then
        print_json_result "$(dump_config_json)"
    else
        local var
        while IFS= read -r var; do
            printf '%s=%s\n' "$var" "${!var:-}"
        done < <(printf '%s\n' "${CONFIG_VARS[@]}" | sort)
    fi
}

dump_config_json() {
    local var
    local args=()
    for var in "${CONFIG_VARS[@]}"; do
        args+=( --arg "$var" "${!var:-}" )
    done 

    jq -c -n "${args[@]}" '$ARGS.named'
}

main() {
    ACTION_NAME="${1:-help}"
    shift || true

    bootstrap_config "$@"

    _load_config_file

    _init_default_config

    set -- "${REMAINING_ARGS[@]}"

    parse_options "$@"

    set -- "${REMAINING_ARGS[@]}"

    # Check required commands
    local required_commands=(curl jq tar sha256sum xz flock)
    local cmd
    for cmd in "${required_commands[@]}"; do
        require_cmd "$cmd"
    done

    init

    log_debug "Configuration: $(dump_config_json)"

    log_debug "Running action: $ACTION_NAME"

    [[ "${DISABLE_HOOKS:-${DEFAULT_CONFIG[DISABLE_HOOKS]:-}}" = "true" ]] || load_hooks

    case "$ACTION_NAME" in
        install)
            acquire_lock
            cmd_install "$@"
            ;;
        update)
            acquire_lock
            cmd_update "$@"
            ;;
        remove)
            acquire_lock
            cmd_remove "$@"
            ;;
        manage)
            acquire_lock
            cmd_manage "$@"
            ;;
        unmanage)
            acquire_lock
            cmd_unmanage "$@"
            ;;
        pkg_add)
            acquire_lock
            cmd_pkg_add "$@"
            ;;
        pkg_del)
            acquire_lock
            cmd_pkg_del "$@"
            ;;
        pkg_list)
            cmd_pkg_list "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        help|--help|-h)
            help_global "$@"
            ;;
        version|--version|-V)
            show_version
            ;;
        dump_config)
            dump_config
            ;;
        *)
            log_error "Unknown action: $ACTION_NAME"
            help_global
            exit 1
            ;;
    esac
}

# Init default configuration variable if file is sourced, otherwise, it's done in main()
[[ "${BASH_SOURCE[0]}" == "${0}" ]] || _init_default_config

# Only run main if script is not sourced
[[ "${BASH_SOURCE[0]}" != "${0}" ]] || main "$@"
