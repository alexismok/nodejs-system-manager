    fi
    
    if ! is_version_managed "$version" && [[ "$version" != "default" ]]; then
        print_result "$(jq '{status: "error", changed: false, msg: "Cannot list package of unmanaged version: \(.data.version)", code: "VERSION_NOT_MANAGED"} * .' <<< "$__out")"
        return 1
    fi

    load_packages "$version"

    local packages
    packages="$(get_packages_json "$version" true)"

    if [[ "$JSON_OUTPUT" == "true" ]]; then
        print_json_result "$packages"
    else
        dump_packages_json "$packages"
    fi
}

cmd_list() {
    local managed_json='[]' unmanaged_json='[]'
    local dir
    for dir in "${NODEJS_ROOT}"/*; do
        [[ -d "$dir" ]] || continue
        local version; version="$(basename "${dir}")"
        [[ "$version" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]] || continue
        local dots="${version//[^.]/}"; dots="${#dots}"

        local type="floating"; [[ "$dots" -eq 2 ]] && type="exact"

        local resolved
        resolved="$(basename "$(readlink -f "${NODEJS_ROOT}/${version}")")"

        local -a childs=()
        mapfile -t childs < <(find_childs "$version" true)
        local version_hierarchy
        version_hierarchy="$(join_by " -> " "${childs[@]}")"

        local json_obj
        json_obj="$(jq -n \
            --arg version "$version" \
            --arg resolved "$resolved" \
            --arg type "$type" \
            --arg version_hierarchy "$version_hierarchy" \
            '{ 
                version: $version,
                resolved: $resolved,
                hierarchy: $version_hierarchy,
                type: $type
            }'
        )"

        if is_version_managed "$version"; then
            managed_json="$(jq --argjson v "$json_obj" '. += [$v]' <<< "$managed_json")"
        else
            unmanaged_json="$(jq --argjson v "$json_obj" '. += [$v]' <<< "$unmanaged_json")"
        fi
    done

    if [[ "$JSON_OUTPUT" == "true" ]]; then
        [[ "${IGNORE_MANAGED:-false}" != "true" ]] || managed_json='[]'
        [[ "${IGNORE_UNMANAGED:-false}" != "true" ]] || unmanaged_json='[]'
        $JSON_OUTPUT_CMD -n --argjson managed "${managed_json:-[]}" --argjson unmanaged "${unmanaged_json:-[]}" \
            '{managed:$managed, unmanaged:$unmanaged}'
    else
        if [[ "${IGNORE_MANAGED:-false}" != "true" ]]; then
            echo "Managed versions:"
            dump_versions "$managed_json"
            [[ "${IGNORE_UNMANAGED:-false}" = "true" ]] || echo
        fi
        if [[ "${IGNORE_UNMANAGED:-false}" != "true" ]]; then
            echo "Unmanaged versions:"
            dump_versions "$unmanaged_json"
        fi
    fi
}

help_global() {
