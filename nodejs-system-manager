cmd_pkg_add() {
    local version="${1:-}"
    local package="${2:-}"

    if [[ -z "$version" ]]; then
        print_result "$(jq -n '{status: "error", changed: false, msg: "Missing version number", code: "MISSING_VERSION"}')"
        [[ "$JSON_OUTPUT" == "true" ]] || help_pkg_add
        return 1
    fi

    if [[ -z "$package" ]]; then
        print_result "$(jq -n '{status: "error", changed: false, msg: "Missing package", code: "MISSING_PACKAGE"}')"
        [[ "$JSON_OUTPUT" == "true" ]] || help_pkg_add
        return 1
    fi

    local __out
    __out="$(jq -n --arg version "$version" --arg package "$package" '{data: {version: $version, package: $package}}')"

    if [[ "$package" =~ $NPM_PKG_FULL_REGEX ]] && [[ "${#BASH_REMATCH[1]}" -lt $NPM_PKG_MAX_LENGTH ]]; then
        local pkg_name="${BASH_REMATCH[1]}"
        local pkg_version="${BASH_REMATCH[4]:-}"
    else
        print_result "$(jq '{status: "success", changed: false, msg: "Invalid package name: \(.data.package)", code: "INVALID_PACKAGE_NAME"} * .' <<< "$__out")" 
        return 1
    fi

    local npm="${BIN_DIR}/npm${version}"

    if [[ "$version" != "default" ]] && [[ ! -d "${NODEJS_ROOT}/${version}" ]] && [[ ! -L "${NODEJS_ROOT}/${version}" ]]; then
        print_result "$(jq '{status: "error", changed: false, msg: "Node.js version \(.data.version) not installed", code: "VERSION_NOT_INSTALLED"} * .' <<< "$__out")"
        return 1
    fi
    
    if [[ "$version" != "default" ]] && ! is_version_managed "$version"; then
        print_result "$(jq '{status: "error", changed: false, msg: "Cannot add package to unmanaged version: \(.data.version)", code: "VERSION_NOT_MANAGED"} * .' <<< "$__out")" 
        return 1
    fi

    local pkg_installed="false"
    local pkg_tracked="false"
    [[ "$version" == "default" ]] || pkg_installed="$(run_cmd "$npm" -g list "$pkg_name" && echo "true" || echo "false")"
    pkg_tracked="$(package_tracked_in_file "$pkg_name" "$version" && echo "true" || echo "false")"
    log_debug "pkg_installed=$pkg_installed"
    log_debug "pkg_tracked=$pkg_tracked"

    if [[ "${FORCE:-false}" != "true" && "$pkg_installed" == "true" && "$pkg_tracked" == "true" ]]; then
        print_result "$(jq '{status: "success", changed: false, msg: "Package already installed, use --force to reinstall or update", code: "PACKAGE_ALREADY_INSTALLED"} * .' <<< "$__out")" 
        return 0
    fi

    if [[ "$version" != "default" && "$pkg_installed" == "false" && "$pkg_tracked" == "true" ]]; then
        log_warn "Package already tracked but not installed, installing it..."
    fi

    local -A versions_tracking_package=()
    local tracked_pkg_mismatch="false"
    if [[ "$version" != "default" ]]; then
        local -a linked_versions=()
        mapfile -t linked_versions < <(find_parents "$version"; find_childs "$version")
        log_debug "linked_versions=(${linked_versions[*]})"
        local tmp_v
        for tmp_v in "${linked_versions[@]}"; do
            local line
            if line="$(package_tracked_in_file "$pkg_name" "$tmp_v" true)"; then
                versions_tracking_package[$tmp_v]="$line"
                if [[ "$package" != "$line" ]]; then
                    tracked_pkg_mismatch="true"
                fi
            fi
        done
        log_debug "!versions_tracking_package=(${!versions_tracking_package[*]})"
        log_debug "versions_tracking_package=(${versions_tracking_package[*]})"
        log_debug "tracked_pkg_mismatch=$tracked_pkg_mismatch"
    fi

    if [[ "${#versions_tracking_package[@]}" -gt 0 && "$tracked_pkg_mismatch" == "true" ]]; then
        for tmp_v in "${!versions_tracking_package[@]}"; do
            if [[ "$package" != "${versions_tracking_package[$tmp_v]}" ]]; then
                log_warn "Version '$tmp_v' track this package with different target: ${versions_tracking_package[$tmp_v]}"
                __out="$(jq --arg version "$tmp_v" --arg target "${versions_tracking_package[$tmp_v]}" '
                    .data.conflicts += [{
                        version: $version,
                        target: $target
                    }]
                ' <<< "$__out")"
            else
                log_debug "Version '$tmp_v' track this package with same target: ${versions_tracking_package[$tmp_v]}"
            fi
        done
        print_result "$(jq \
            --arg msg "Package '$pkg_name' is tracked by linked versions with a different target" \
            '{status: "error", changed: false, msg: $msg, code: "PACKAGE_TARGET_MISMATCH_WITH_LINKED_VERSION"} * .' <<< "$__out"
        )" 
        return 1
    fi

    local install_packages_rc=0
    if [[ "$version" != "default" ]]; then
        if [[ "${FORCE:-false}" == "true" || "$pkg_installed" != "true" ]]; then
            local install_packages_result
            reset_packages
            add_package "$pkg_name" "$pkg_version" "cli"
            install_packages "$version" install_packages_result || install_packages_rc=$?
        fi
    fi

    if [[ "$install_packages_rc" -eq 0 ]] || [[ "$version" == "default" ]]; then
        local escaped_pkg_name
        escaped_pkg_name=$(regex_escape "$pkg_name")
        log_debug "Escaped package name: $escaped_pkg_name"
        if [[ -f "${PACKAGES_DIR}/${version}" ]] && grep -qxE "^${escaped_pkg_name}(@.*)?$" "${PACKAGES_DIR}/${version}"; then
            log_debug "Package already in ${PACKAGES_DIR}/${version}. Removing it before adding it again to update version constraint"
            run_cmd sed -i -E "/^${escaped_pkg_name}(@.*)?$/d" "${PACKAGES_DIR}/${version}"
        fi
        echo "$package" >> "${PACKAGES_DIR}/${version}"
        log_info "Added package '$package' to ${PACKAGES_DIR}/${version}"

        log_success "Successfully added package: ${package}"
    fi

    if [[ "$version" == "default" ]]; then
        print_result "$(jq -n \
            --arg version "$version" \
            --arg pkg "$pkg_name" \
            --arg pkg_policy "${pkg_version:-}" \
            '{
                status: "success",
                changed: true,
                code: "PACKAGE_ADDED_AS_DEFAULT",
                msg: "Package as been added as default for future versions",
                data: {
                    version: $version,
                    package_name: $pkg,
                    package_policy: $pkg_policy
                }
            }'
        )"
    elif [[ "${FORCE:-false}" != "true" && "$pkg_installed" == "true" && "$pkg_tracked" == "false" ]]; then
        print_result "$(jq \
            '{
                status: "success",
                changed: true, 
                msg: "Package already installed but not tracked, added to track list",
                code: "PACKAGE_TRACKED"
            } * .' <<< "$__out"
        )" 
    else
        print_json_result "$(jq -n \
            --arg version "$version" \
            --arg pkg "$pkg_name" \
            --arg pkg_policy "${pkg_version:-}" \
            --argjson install_packages_result "$install_packages_result" \
            '{
                status: $install_packages_result.status,
                changed: $install_packages_result.changed,
                code: $install_packages_result.code,
                msg: $install_packages_result.msg,
                data: {
                    version: $version,
                    package_name: $pkg,
                    package_version: $install_packages_result.data.packages[0].version,
                    package_policy: $pkg_policy
                }
            }'
        )"
        return "$install_packages_rc"
    fi
}

cmd_pkg_del() {
    local version="${1:-}"
    local package="${2:-}"
    local __out

    if [[ -z "$version" ]]; then
        print_result "$(jq -n '{status: "error", changed: false, msg: "Missing version number", code: "MISSING_VERSION"}')"
        [[ "$JSON_OUTPUT" == "true" ]] || help_pkg_add
        return 1
    fi

    if [[ -z "$package" ]]; then
        print_result "$(jq -n '{status: "error", changed: false, msg: "Missing package", code: "MISSING_PACKAGE"}')"
        [[ "$JSON_OUTPUT" == "true" ]] || help_pkg_add
        return 1
    fi

    local __out
    __out="$(jq -n --arg version "$version" --arg package "$package" '{data: {version: $version, package: $package}}')"

    if ! [[ "$package" =~ $NPM_PKG_NAME_REGEX ]]; then
        print_result "$(jq '{status: "error", changed: false, msg: "Invalid package name: \(.data.package)", code: "INVALID_PACKAGE_NAME"} * .' <<< "$__out")" 
        return 1
    fi

    local npm="${BIN_DIR}/npm${version}"

    if [[ "$version" != "default" ]] && [[ ! -d "${NODEJS_ROOT}/${version}" ]] && [[ ! -L "${NODEJS_ROOT}/${version}" ]]; then
        print_result "$(jq '{status: "error", changed: false, msg: "Node.js version \(.data.version) not installed", code: "VERSION_NOT_INSTALLED"} * .' <<< "$__out")"
        return 1
    fi
    
    if [[ "$version" != "default" ]] && ! is_version_managed "$version"; then
        print_result "$(jq '{status: "error", changed: false, msg: "Cannot delete package from unmanaged version: \(.data.version)", code: "VERSION_NOT_MANAGED"} * .' <<< "$__out")" 
        return 1
    fi

    local pkg_installed="false"
    local pkg_tracked="false"
    [[ "$version" == "default" ]] || pkg_installed="$(run_cmd "$npm" -g list "$package" && echo "true" || echo "false")"
    pkg_tracked="$(package_tracked_in_file "$package" "$version" && echo "true" || echo "false")"
    log_debug "pkg_installed=$pkg_installed"
    log_debug "pkg_tracked=$pkg_tracked"

    if [[ "$pkg_tracked" == "false" ]]; then
        print_result "$(jq '{status: "success", changed: false, msg: "Package not tracked by this version, nothing to do", code: "PACKAGE_NOT_TRACKED"} * .' <<< "$__out")" 
        return 0
    fi

    local pre_hook_rc=0
    run_pre_hook "pre_del_package" "Package installation for version '$version'" __out || pre_hook_rc=$?
    [[ "$pre_hook_rc" -eq 0 ]] || { print_result "$__out"; return "$pre_hook_rc"; }
    [[ "$HOOK_SKIP" != "true" ]] || { print_json_result "$__out"; return 0; }

    local -a versions_using_package=()
    if [[ "$version" != "default" && "$pkg_installed" == "true" ]]; then
        local -a linked_versions=()
        
        mapfile -t linked_versions < <(find_parents "$version"; find_childs "$version")
        log_debug "Linked_versions=(${linked_versions[*]})"

        local tmp_v
        for tmp_v in "${linked_versions[@]}"; do
            if package_tracked_in_file "$package" "$tmp_v"; then
                versions_using_package+=("$tmp_v")
            fi
        done

        if package_tracked_in_file "$package" default; then
            versions_using_package+=(default)
        fi

        if [[ "${#versions_using_package[@]}" -gt 0 ]]; then
            log_debug "Package '${package}' is required by linked versions: ${versions_using_package[*]}"
        else
            if ! run_cmd "$npm" uninstall -g "$package"; then
                print_result "$(jq '{status: "error", changed: false, msg: "Package removal failed: \(.data.package)", code: "PACKAGE_REMOVAL_FAILED"} * .' <<< "$__out")" 
                return 1
            fi
            log_info "Removed package '${package}' from version '${version}'"
        fi
    fi

    local escaped_pkg_name
    escaped_pkg_name=$(regex_escape "$package")
    log_debug "Escaped package name: $escaped_pkg_name"

    run_cmd sed -i -E "/^${escaped_pkg_name}(@.*)?$/d" "${PACKAGES_DIR}/${version}"
    log_info "Removed package '$package' from ${PACKAGES_DIR}/${version}"

    if [[ "${#versions_using_package[@]}" -gt 0 ]]; then
        __out="$(jq \
            --arg v "${versions_using_package[*]}" \
            '{
                status: "warning",
                changed: true,
                msg: "Package is required by versions (\($v)), only removed from config file",
                code: "PACKAGE_UNTRACKED_STILL_REQUIRED"
            } * .' <<< "$__out"
        )" 
    else
        if [[ "$version" == "default" ]]; then
            __out="$(jq \
                '
                {
                    status: "success",
                    changed: true,
                    code: "PACKAGE_REMOVED_FROM_DEFAULT",
                    msg: "Successfully removed package from default: \(.data.package)",
                } * .' <<< "$__out"
            )" 
        elif [[ "$pkg_installed" == "true" ]]; then
            __out="$(jq \
                '{
                    status: "success",
                    changed: true,
                    code: "PACKAGE_REMOVED",
                    msg: "Successfully removed package: \(.data.package)",
                } * .' <<< "$__out"
            )" 
        else
            __out="$(jq \
                '{
                    status: "success",
                    changed: true,
                    code: "PACKAGE_UNTRACKED",
                    msg: "Package were not installed, untracked it: \(.data.package)",
                } * .' <<< "$__out"
            )" 
        fi
    fi

    local post_hook_rc=0
    run_post_hook "post_del_package" __out || post_hook_rc=$?

    print_result "$__out"
    return "$post_hook_rc"
}

